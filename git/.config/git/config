# Tibor's Git configuration.
[user]
  email = tibor.simko@cern.ch
  name = Tibor Šimko
  signingkey = BA5A2B67
[include]
  path = config.local  # contains user secrets such as hub tokens
[core]
  pager = less
[interactive]
  diffFilter = delta --color-only
[delta]
  blame-palette = "#242424 #282828"
  file-decoration-style = none
  file-style = dim bold
  hunk-header-decoration-style = none
  light = false
  line-numbers-left-style = dim black
  line-numbers-right-style = dim black
  navigate = true
  side-by-side = false
[commit]
  gpgsign = true
[alias]
  # Keep personal shortcuts to one-letter roots; refine them with arguments.
  a = add
  b = "!f() { ~/.config/git/git-branches.sh \"$@\"; }; f"
  c = checkout
  d = diff
  f = "!f() { ~/.config/git/git-fetch.sh \"$@\"; }; f"
  g = grep
  i = "!f() { ~/.config/git/git-forge.sh issue \"$@\"; }; f"
  k = log --graph --decorate --pretty=format:'%C(blue)%d%Creset %C(yellow)%h%Creset %s, %C(bold green)%an%Creset, %C(green)%cd%Creset' --date=relative --all
  l = "!f() { ~/.config/git/git-log.sh \"$@\"; }; f"
  p = "!f() { ~/.config/git/git-forge.sh pr \"$@\"; }; f"
  r = "!f() { ~/.config/git/git-forge.sh repo \"$@\"; }; f"
  s = status -s
  x = "!f() { ~/.config/git/git-x.sh \"$@\"; }; f"
[color]
  ui = auto
  branch = auto
  interactive = auto
  status = auto
[diff]
  tool = nvimdiff
  renamelimit = 99999
  colorMoved = default
[grep]
  lineNumber = true
[merge]
  tool = nvimdiff
  conflictstyle = zdiff3
[mergetool]
  keepBackup = false
  prompt = false
[rerere]
  enabled = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
