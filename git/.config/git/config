# Tibor's Git configuration.
[user]
  email = tibor.simko@cern.ch
  name = Tibor Šimko
  signingkey = BA5A2B67
[include]
  path = config.local  # contains user secrets such as hub tokens
[core]
  pager = less
[interactive]
  diffFilter = delta --color-only
[delta]
  blame-palette = "#242424 #282828"
  file-decoration-style = none
  file-style = dim bold
  hunk-header-decoration-style = none
  light = false
  line-numbers-left-style = dim black
  line-numbers-right-style = dim black
  navigate = true
  side-by-side = false
[commit]
  gpgsign = true
[alias]
  a = add
  ci = commit
  k = log --graph --decorate --pretty=format:'%C(blue)%d%Creset %C(yellow)%h%Creset %s, %C(bold green)%an%Creset, %C(green)%cd%Creset' --date=relative
  ka = log --graph --decorate --pretty=format:'%C(blue)%d%Creset %C(yellow)%h%Creset %s, %C(bold green)%an%Creset, %C(green)%cd%Creset' --date=relative --all
  g = grep
  l = log --format=oneline
  lg = log gh-pages.. --format=oneline
  lgp = log gh-pages.. -p
  lgs = log gh-pages.. --stat
  lm = log master.. --format=oneline
  lmp = log master.. -p
  lms = log master.. --stat
  lp = log production.. --format=oneline
  lpp = log production.. -p
  lps = log production.. --stat
  lq = log qa.. --format=oneline
  lqp = log qa.. -p
  lqs = log qa.. --stat
  xq = log production..qa
  co = checkout
  cog = checkout gh-pages
  com = checkout master
  cop = checkout production
  coq = checkout qa
  lbi = !"git for-each-ref --format='%(committerdate:short) %(refname)' --sort=committerdate refs/heads/*$1*"
  rbi = !"git for-each-ref --format='%(committerdate:short) %(refname)' --sort=committerdate refs/remotes/$1"
  b = branch -vv
  s = status -s
  f = fetch
  m = merge --ff-only
  fu = fetch upstream
  pom = push origin master
  pum = push upstream master
  merge-push-delete-branch = !sh -c 'git fetch upstream && git fetch origin && git checkout master && git merge --ff-only upstream/master && git merge --ff-only $1 && git branch -d $1 && git push upstream master && git push origin master && git push origin :$1' -
  merge-push-delete-pr = !sh -c 'git fetch upstream && git checkout master && git merge --ff-only upstream/master && git merge --ff-only upstream/pr/$1 && git branch -d pr-$1 && git push upstream master && git push origin master' -
  d = diff
  dg = diff gh-pages
  dm = diff master
  dp = diff production
  dq = diff qa
  dgs = diff gh-pages --stat
  dms = diff master --stat
  dps = diff production --stat
  dqs = diff qa --stat
  dog = diff gh-pages origin/gh-pages
  dom = diff master origin/master
  dop = diff production origin/production
  doq = diff qa origin/qa
  dug = diff gh-pages upstream/gh-pages
  dum = diff master upstream/master
  dup = diff production upstream/production
  duq = diff qa upstream/qa
  mog = !"git checkout gh-pages && git merge --ff-only origin/gh-pages && git checkout -"
  mom = !"git checkout master && git merge --ff-only origin/master && git checkout -"
  mop = !"git checkout production && git merge --ff-only origin/production && git checkout -"
  moq = !"git checkout qa && git merge --ff-only origin/qa && git checkout -"
  mug = !"git checkout gh-pages && git merge --ff-only upstream/gh-pages && git checkout -"
  mum = !"git checkout master && git merge --ff-only upstream/master && git checkout -"
  mup = !"git checkout production && git merge --ff-only upstream/production && git checkout -"
  muq = !"git checkout qa && git merge --ff-only upstream/qa && git checkout -"
  w = !gh repo view -w 
  wi = !gh issue view -w 
  wii = !gh issue list -w 
  wp = !gh pr view -w 
  wpp = !gh pr list -w 
[color]
  ui = auto
  branch = auto
  interactive = auto
  status = auto
[diff]
  tool = nvimdiff
  renamelimit = 99999
  colorMoved = default
[grep]
  lineNumber = true
[magithub]
  online = true
  contextRemote = "upstream"
[magithub "status"]
  includeStatusHeader = true
  includePullRequestsSection = true
  includeIssuesSection = true
[merge]
  tool = nvimdiff
  conflictstyle = zdiff3
[mergetool]
  keepBackup = false
  prompt = false
[rerere]
  enabled = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
