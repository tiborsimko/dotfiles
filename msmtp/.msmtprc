# Tibor's msmtp configuration.

# Defaults for all accounts
defaults
auth on
port 587
protocol smtp
tls on

# CERN
account cern
host smtp.office365.com
from tibor.simko@cern.ch
user tibor.simko@cern.ch
auth xoauth2
passwordeval ~/.config/oauth2/mutt_oauth2.py ~/.config/oauth2/tibor.simko@cern.ch.tokens

# vim:filetype=msmtp
