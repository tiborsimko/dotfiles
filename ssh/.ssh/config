# Tibor's ssh config.

Include ~/.colima/ssh_config

Host *
  ControlMaster auto
  ControlPath ~/.ssh/master-%r@%h:%p
  ControlPersist 60
  IgnoreUnknown UseKeychain,WarnWeakCrypto

Host *.cern.ch
  User simko
  WarnWeakCrypto no

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_rsa

Host gitlab.cern.ch
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_rsa
