# Tibor's dunst configuration.

[global]
    font = monospace 10
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "300x5-30+20"
    shrink = no
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    line_height = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame
    startup_notification = false
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox
    icon_position = off
    icon_folders = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    close = mod4+q

[frame]
    width = 1
    frame_color = "#282828"
    separator_color = "#282828"

[urgency_low]
    background = "#83a598"
    foreground = "#282828"
    frame_color = "#83a598"
    timeout = 10

[urgency_normal]
    background = "#8ec07c"
    foreground = "#282828"
    frame_color = "#8ec07c"
    timeout = 10

[urgency_critical]
    background = "#fb4934"
    foreground = "#ebdbb2"
    frame_color = "#fb4934"
    timeout = 0
