# Tibor's neomutt configuration.

# Colour scheme. theme-current is a local symlink managed by theme-toggle;
# reading exactly one file avoids leaking additive colour rules across themes.
source "if test -r ~/.config/neomutt/theme-current; then cat ~/.config/neomutt/theme-current; else cat ~/.config/neomutt/theme-light; fi|"

# Speed
set sleep_time = 0

# Keep ordinary error bells disabled, but alert Tmux about new mail
set beep = no
set beep_new = yes

# Check the open Maildir regularly while NeoMutt is idle.  The macOS build has
# no inotify support, so timeout controls how quickly local delivery is seen.
set check_new = yes
set timeout = 30

# Attachments
set mailcap_path = ~/.config/neomutt/mailcap

# Sort preferences
set sort=threads
set sort_browser=reverse-date
set sort_aux=last-date-received
set collapse_unread = no
set uncollapse_jump = yes
set mark_old = no

# HTML mail
auto_view text/html
alternative_order text/plain text/enriched text/html

# CERN
set mbox_type = Maildir
set folder = ~/Local/mbsyncmail
set spoolfile = +INBOX
set header_cache = ~/.cache/neomutt
set message_cachedir = ~/.cache/neomutt
set postponed = =Drafts
set record = =Archive
save-hook . =Archive

# Wrap lines when viewing mail
set wrap=80
set smart_wrap=yes

# Do not show any leading markers when wrapping lines
set markers=no

# Show mail index when viewing a message
set pager_index_lines=10

# View message headers in wanted order
unhdr_order *
hdr_order From: To: Cc: Subject: Date:

# Composing mail
#my_hdr Bcc: Tibor Simko <tibor.simko@cern.ch>
set attribution_intro = "On %[!%a, %d %b %Y at %H:%M], %n wrote:"
set fast_reply = yes
set include = yes
set edit_headers = no
set text_flowed = yes
set signature = "~/.config/neomutt/signature"
unset sig_dashes

# Autocomplete email addresses
set query_command = "echo && notmuch address from:%s"
set query_format="%4c %t %-70.70a %-70.70n %?e?(%e)?"
bind editor <Tab> complete-query
bind editor ^T complete

# Sending mail
set realname = "Tibor Simko"
set from = "tibor.simko@cern.ch"
set sendmail = "/opt/homebrew/bin/msmtp --account=cern"

# Native notmuch integration (enables notmuch:// virtual folders)
set nm_default_url = "notmuch://$HOME/Local/mbsyncmail"

# Key bindings - reload colour theme (driven externally by theme-toggle via tmux)
macro index,pager <F5> "<enter-command>source ~/.config/neomutt/neomuttrc<enter>" "Reload colour theme"

# Key bindings - general vim-like
bind index,pager,attach g noop
bind attach,index gg first-entry
bind pager gg top
bind pager G bottom
bind attach,index G last-entry
bind index,pager R group-reply
bind index,pager C mail
bind index m mark-message

# Key bindings - quick folder operations
macro index,pager ,,  "<change-folder>=INBOX<enter><limit>~U<enter>" "Go to unread in INBOX"
macro index,pager g1  "<change-folder>=INBOX<enter><limit>~(~d <1d)<enter>" "Go to last 1 day in INBOX"
macro index,pager g7  "<change-folder>=INBOX<enter><limit>~(~d <1w)<enter>" "Go to 7 days in INBOX"
macro index,pager g9  "<change-folder>=INBOX<enter><limit>~(~d <30d)<enter>" "Go to 30 days in INBOX"
macro index,pager ga  "<change-folder>=Archive<enter>" "Go to Archive folder"
macro index,pager gh  "<change-folder>=Github<enter>" "Go to Github folder (all)"
macro index,pager gi  "<change-folder>=INBOX<enter>" "Go to INBOX folder"
macro index,pager gn  "<change-folder>notmuch://?query=folder:Github%20and%20%28subject:neovim%20or%20subject:lazyvim%20or%20subject:lazy.nvim%29<enter>" "Go to Github view (neovim)"
macro index,pager go  "<change-folder>notmuch://?query=folder:Github%20and%20not%20%28subject:cernopendata%20or%20subject:continuous-reuse%20or%20subject:lhcb-ntupling-service%20or%20subject:reana*%29<enter>" "Go to Github view (other)"
macro index,pager gp  "<change-folder>notmuch://?query=folder:Github%20and%20%28subject:puppet%20or%20subject:inveniosoftware%20or%20subject:inspire*%20or%20subject:cds-videos%29<enter>" "Go to Github view (puppet, inveniosoftware, etc)"
macro index,pager gs  "<change-folder>=Spam<enter>" "Go to Spam folder"
macro index,pager gu  "<change-folder>=INBOX<enter><limit>~U<enter>" "Go to unread in INBOX"
macro index,pager gw  "<change-folder>notmuch://?query=folder:Github%20and%20%28subject:cernopendata%20or%20subject:continuous-reuse%20or%20subject:lhcb-ntupling-service%20or%20subject:reana*%29<enter>" "Go to Github view (work)"
macro index,pager ,w1 "<limit>~(~d <1d)<enter>" "Widen to last 1 day"
macro index,pager ,w7 "<limit>~(~d <1w)<enter>" "Widen to last 7 days"
macro index,pager ,w9 "<limit>~(~d <30d)<enter>" "Widen to last 30 days"
macro index,pager ,wa "<limit>all<enter>" "Widen to all messages"

# Key bindings - mail archiving
macro index,pager ,a ":set confirmappend=no delete=yes auto_tag=yes\n<save-message>=Archive\n<sync-mailbox>:set confirmappend=yes delete=ask-yes\n" "Move message(s) to Archive"

# Key bindings - taskwarrior capture
macro index,pager ,c "<pipe-message>$HOME/.config/task/task-capture-mail.sh<enter>" "Capture as taskwarrior task"
macro index,pager ,t "<pipe-message>$HOME/.config/task/task-capture-mail.sh<enter>" "Capture as taskwarrior task"

# Key bindings - taskwarrior jump
macro index,pager ,j "<enter-command>source ~/.cache/neomutt-jump.rc<enter>" "Jump to message prepared by task-jump-mail.sh"

# Key bindings - native notmuch
macro index ,s "<vfolder-from-query>" "notmuch: search mail"
bind index ,l limit-current-thread
macro pager ,l "<exit><limit-current-thread>" "Limit to current thread"
macro index ,L "<entire-thread>" "notmuch: reconstruct thread"

# Key bindings - mbsync
macro index ,u \
"<enter-command>set my_old_pipe_decode=\$pipe_decode my_old_wait_key=\$wait_key nopipe_decode nowait_key<enter>\
<shell-escape>mail-sync --notmuch<enter>\
<enter-command>set pipe_decode=\$my_old_pipe_decode wait_key=\$my_old_wait_key<enter>" \
"Update notmuch (fast)"
macro index ,x \
"<enter-command>set my_old_pipe_decode=\$pipe_decode my_old_wait_key=\$wait_key nopipe_decode nowait_key<enter>\
<shell-escape>mail-sync --scope inbox<enter>\
<enter-command>set pipe_decode=\$my_old_pipe_decode wait_key=\$my_old_wait_key<enter>" \
"Synchronise inbox folders (fast)"
macro index ,y \
"<enter-command>set my_old_pipe_decode=\$pipe_decode my_old_wait_key=\$wait_key nopipe_decode nowait_key<enter>\
<shell-escape>mail-sync --scope inbox --scope archive<enter>\
<enter-command>set pipe_decode=\$my_old_pipe_decode wait_key=\$my_old_wait_key<enter>" \
"Synchronise inbox folders and current archive (medium)"
macro index ,z \
"<enter-command>set my_old_pipe_decode=\$pipe_decode my_old_wait_key=\$wait_key nopipe_decode nowait_key<enter>\
<shell-escape>mail-sync --scope all<enter>\
<enter-command>set pipe_decode=\$my_old_pipe_decode wait_key=\$my_old_wait_key<enter>" \
"Synchronise inbox folders and all past archives (slow)"
