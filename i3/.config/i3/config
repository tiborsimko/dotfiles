# Tibor's i3 configuration.

# Set modifier key
set $mod Mod4

# Set font for window titles and status bar
font pango:monospace 10

# Recognise laptop volume keys
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Recognise laptop backlight keys
bindsym XF86MonBrightnessUp exec light -A 5
bindsym XF86MonBrightnessDown exec light -U 5

# Define Movement keys
set $left h
set $down j
set $up k
set $right l

# Use Mouse+$mod to drag floating windows around
floating_modifier $mod

# Open new terminal window
bindsym $mod+Return exec alacritty

# Open new browser window
bindsym $mod+Shift+Return exec firefox --new-window

# Kill focused window
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c kill

# Start program launcher
bindsym $mod+r exec rofi -theme gruvbox-dark-hard -font 'monospace 10' -show-icons -show run

# Change focus between windows
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+n focus down
bindsym $mod+p focus up

# Move focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+n move down
bindsym $mod+Shift+p move up

# Split over in horizontal orientation
bindsym $mod+o split horizontal

# Split under in vertical orientation
bindsym $mod+u split vertical

# Zoom focused container
bindsym $mod+z fullscreen toggle

# Default layout
workspace_layout stacking

# Change container layout
bindsym $mod+m layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+v layout splith
bindsym $mod+s layout splitv

# Toggle tiling / floating
bindsym $mod+Shift+f floating toggle

# Change focus between tiling / floating windows
bindsym $mod+f focus mode_toggle

# Focus parent container
bindsym $mod+a focus parent

# Focus the child container
bindsym $mod+c focus child

# Move the currently focused window to scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show next scratchpad window or hide focused scratchpad window
bindsym $mod+minus scratchpad show

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1; workspace 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace 9

# Bring container from workspace
bindsym $mod+Control+1 mark current; workspace 1; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+2 mark current; workspace 2; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+3 mark current; workspace 3; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+4 mark current; workspace 4; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+5 mark current; workspace 5; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+6 mark current; workspace 6; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+7 mark current; workspace 7; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+8 mark current; workspace 8; move container to mark current; [con_mark="current"] focus; unmark current
bindsym $mod+Control+9 mark current; workspace 9; move container to mark current; [con_mark="current"] focus; unmark current

# Toggle sticky on focused container
bindsym $mod+Shift+0 sticky toggle

# Move current workspace to the next monitor
bindsym $mod+e move workspace to output next

# Restart WM in place (preserving layout/session)
bindsym $mod+Ctrl+r restart

# Exit WM
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize containers
bindsym $mod+Ctrl+$left resize shrink width 5 px or 5 ppt
bindsym $mod+Ctrl+$right resize grow width 5 px or 5 ppt
bindsym $mod+Ctrl+$up resize grow height 5 px or 5 ppt
bindsym $mod+Ctrl+$down resize shrink height 5 px or 5 ppt

bindsym $mod+Ctrl+Left resize shrink width 5 px or 5 ppt
bindsym $mod+Ctrl+Right resize grow width 5 px or 5 ppt
bindsym $mod+Ctrl+Up resize grow height 5 px or 5 ppt
bindsym $mod+Ctrl+Down resize shrink height 5 px or 5 ppt

# Use Gruvbox Material medium dark color scheme (shaded via <https://www.colorhexa.com/8ec07c>)
set $aqua #8ec07c
set $aqua_h #689d6a
set $aqua_hh #426b34
set $aqua_hhh #3a5e2d
set $aqua_hhhh #325127
set $aqua_hhhhh #2a4421
set $aqua_hhhhhh #22361a
set $aqua_hhhhhhh #192914
set $bg0 #282828
set $bg0_h #1d2021
set $bg0_hh #1c1c1c
set $bg0_s #32302f
set $bg1 #3c3836
set $bg2 #504945
set $bg3 #665c54
set $bg4 #7c6f64
set $black #000000
set $blue #83a598
set $blue_h #458588
set $fg #fbf1c7
set $fg0 #ebdbb2
set $fg1 #ebdbb2
set $fg2 #d5c4a1
set $fg3 #bdae93
set $fg4 #a89984
set $gray #928374
set $green #b8bb26
set $green_h #98971a
set $green_hh #55540f
set $orange #fe8019
set $orange_h #d65d0e
set $purple #d3869b
set $purple_h #b16286
set $red #fb4934
set $red_h #cc241d
set $yellow #fabd2f
set $yellow_h #d79921

# Window title bars blackish
# class                 border backgr text indicator child_border
client.focused          $black $black $aqua_h $green $aqua_hhh
client.focused_inactive $black $black $fg4 $green $bg0
client.unfocused        $black $black $bg4 $green $bg0_h
client.urgent           $black $black $red $red $red
client.placeholder      $black $black $fg0 $green $black
client.background       $fg0

# Start bar
bar {
  modifier none
  position top
  status_command i3status
  colors {
    background $black
    statusline $fg4
    # workspaces         border backgr text
    focused_workspace    $black $black $aqua_h
    inactive_workspace   $black $black $fg4
    active_workspace     $black $black $fg4
    urgent_workspace     $black $black $red
  }
}

# Toggle bar
bindsym $mod+b bar mode toggle

# Configure window borders
hide_edge_borders smart

# Configure window titles
default_border pixel 1px
for_window [all] border pixel 1px
for_window [all] title_window_icon no

# Configure gaps
gaps inner 6px
gaps outer 0px
smart_gaps on

# Configure behaviour of pop-ups when in fullscreen mode
popup_during_fullscreen leave_fullscreen

# Focus movement commands should stay within current workspace; useful in
# multi-monitor setups
focus_wrapping workspace

# Jump to urgent windows
focus_on_window_activation focus
bindsym $mod+i [urgent=latest] focus

# Jump between workspaces
bindsym $mod+bracketleft workspace prev
bindsym $mod+shift+bracketleft move container to workspace prev
bindsym $mod+bracketright workspace next
bindsym $mod+shift+bracketright move container to workspace next
bindsym $mod+space workspace back_and_forth
bindsym $mod+Tab workspace back_and_forth

# Jump to any window
bindsym $mod+w exec rofi -theme gruvbox-dark-hard -font 'monospace 10' -show-icons -show window

# Jump between two fullscreen applications
bindsym $mod+x fullscreen disable; focus right; fullscreen enable
bindsym $mod+y fullscreen disable; focus down; fullscreen enable
